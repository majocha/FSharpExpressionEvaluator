<Project Sdk="Microsoft.NET.Sdk">

  <!-- IDE-side component: loads only in devenv (docs/DESIGN.md §4). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>FSharp.ExpressionEvaluator</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);9</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Log.fs" Link="Shared\Log.fs" />
    <Compile Include="..\FSharp.ExpressionEvaluator.ResultProvider\Model.fs" Link="Shared\Model.fs" />
    <Compile Include="..\FSharp.ExpressionEvaluator.ResultProvider\FSharpTypes.fs" Link="Shared\FSharpTypes.fs" />
    <Compile Include="PeImage.fs" />
    <Compile Include="MetadataTypes.fs" />
    <Compile Include="MethodNames.fs" />
    <Compile Include="ReturnValues.fs" />
    <Compile Include="Evaluation.fsi" />
    <Compile Include="Evaluation.fs" />
    <Compile Include="Debuggee.fs" />
    <Compile Include="FrameDecoder.fs" />
    <Compile Include="ExpressionCompiler.fs" />
  </ItemGroup>

  <ItemGroup>
    <VsdConfigXmlFiles Include="ExpressionCompiler.vsdconfigxml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Debugger.Engine" />
    <PackageReference Include="Microsoft.VisualStudio.Debugger.Metadata" />
    <PackageReference Include="Microsoft.VSSDK.Debugger.VSDConfigTool" PrivateAssets="all" />
    <!-- Provided by devenv through binding redirects + codeBase; not shipped. -->
    <PackageReference Include="System.Reflection.Metadata" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.DiaSymReader" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The private F# compiler (docs/DESIGN.md §8.2), built by eng/Build-Compiler.ps1. -->
  <PropertyGroup>
    <FSharpEECompiler>$(MSBuildThisFileDirectory)..\..\artifacts\compiler\FSharp.ExpressionEvaluator.Compiler.dll</FSharpEECompiler>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="FSharp.ExpressionEvaluator.Compiler">
      <HintPath>$(FSharpEECompiler)</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CheckFSharpEECompiler" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(FSharpEECompiler)')" Text="The private F# compiler is missing: run eng\Build-Compiler.ps1." />
  </Target>

</Project>
