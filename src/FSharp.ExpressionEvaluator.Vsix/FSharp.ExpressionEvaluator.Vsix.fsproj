<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!--
    Packaging project (docs/DESIGN.md §10). The VSIX carries the Concord components (dll + vsdconfig),
    the private F# compiler (eng/Build-Compiler.ps1), FSharp.Core for hosts without the F# workload,
    and this assembly: a package that registers the on/off option and mirrors it (§19).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FSharp.ExpressionEvaluator.Vsix</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <VsixType>v3</VsixType>
    <DeployExtension>false</DeployExtension>
    <TargetVSVersion>18.0</TargetVSVersion>
    <VSSDKTargetPlatformRegRootSuffix>Exp</VSSDKTargetPlatformRegRootSuffix>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/RootSuffix Exp /Log</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Log.fs" Link="Shared\Log.fs" />
    <Compile Include="..\Shared\Settings.fs" Link="Shared\Settings.fs" />
    <Compile Include="Package.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="registration.json">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharp.ExpressionEvaluator.ResultProvider\FSharp.ExpressionEvaluator.ResultProvider.fsproj">
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup</IncludeOutputGroupsInVSIX>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\FSharp.ExpressionEvaluator.ExpressionCompiler\FSharp.ExpressionEvaluator.ExpressionCompiler.fsproj">
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup</IncludeOutputGroupsInVSIX>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgFSharp_Core)\lib\netstandard2.0\FSharp.Core.dll" Link="FSharp.Core.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\artifacts\compiler\FSharp.ExpressionEvaluator.Compiler.dll" Link="FSharp.ExpressionEvaluator.Compiler.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" />

  <!-- VSSDK build tools declare the CSharp capability, which makes VS use the C# language service. -->
  <ItemGroup>
    <ProjectCapability Remove="CSharp" />
  </ItemGroup>
</Project>
