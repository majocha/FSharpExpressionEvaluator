<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TypeNameFormatter.fs" />
    <Compile Include="ValueFormatter.fs" />
    <Compile Include="ExpressionLowering.fs" />
    <Compile Include="Formatter.fs" />
    <Compile Include="ExpressionCompiler.fs" />
  </ItemGroup>

  <ItemGroup />

  <ItemGroup>
    <None Include="Formatter.vsdconfigxml" />
    <None Include="Compiler.vsdconfigxml" />
  </ItemGroup>

  <ItemGroup>
    <!--
      vsdconfigtool.exe (which processes VsdConfigXmlFiles) is a Windows-only
      binary.  Exclude the item on non-Windows so CreateVsdbgConfigFile skips
      itself via its own Condition="'@(VsdConfigXmlFiles)'!=''" guard, keeping
      the build usable on Linux / macOS CI without touching the Windows path.
    -->
    <VsdConfigXmlFiles Include="Formatter.vsdconfigxml"
                       Condition="'$([MSBuild]::IsOSPlatform(Windows))' == 'true'" />
    <VsdConfigXmlFiles Include="Compiler.vsdconfigxml"
                       Condition="'$([MSBuild]::IsOSPlatform(Windows))' == 'true'" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Debugger.Engine" Version="17.8.1101801" />
    <PackageReference Include="Microsoft.VisualStudio.Debugger.Metadata" Version="17.8.1101801" />
    <PackageReference Include="Microsoft.VSSDK.Debugger.VSDConfigTool" Version="17.8.1101801">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
