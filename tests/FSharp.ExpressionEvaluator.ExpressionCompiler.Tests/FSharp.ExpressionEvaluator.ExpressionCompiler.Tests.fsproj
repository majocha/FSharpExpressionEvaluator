<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the expression compiler component's Concord-free core: frame names, and
    expressions compiled by the private F# compiler. Fixtures are F# code in this assembly, read
    back through System.Reflection.Metadata; for expressions, this assembly is the debuggee.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>FSharp.ExpressionEvaluator.Tests</RootNamespace>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Shared\Log.fs" Link="Core\Log.fs" />
    <Compile Include="..\..\src\FSharp.ExpressionEvaluator.ResultProvider\Model.fs" Link="Core\Model.fs" />
    <Compile Include="..\..\src\FSharp.ExpressionEvaluator.ResultProvider\FSharpTypes.fs" Link="Core\FSharpTypes.fs" />
    <Compile Include="..\..\src\FSharp.ExpressionEvaluator.ExpressionCompiler\MetadataTypes.fs" Link="Core\MetadataTypes.fs" />
    <Compile Include="..\..\src\FSharp.ExpressionEvaluator.ExpressionCompiler\MethodNames.fs" Link="Core\MethodNames.fs" />
    <Compile Include="..\..\src\FSharp.ExpressionEvaluator.ExpressionCompiler\Evaluation.fsi" Link="Core\Evaluation.fsi" />
    <Compile Include="..\..\src\FSharp.ExpressionEvaluator.ExpressionCompiler\Evaluation.fs" Link="Core\Evaluation.fs" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="MethodNameTests.fs" />
    <Compile Include="EvaluationIntrinsics.fs" />
    <Compile Include="StartupFixture.fs" />
    <Compile Include="NamespaceStartupFixture.fs" />
    <Compile Include="EvaluationTests.fs" />
  </ItemGroup>

  <!-- The private F# compiler, built by eng/Build-Compiler.ps1; it makes this assembly a friend. -->
  <ItemGroup>
    <Reference Include="FSharp.ExpressionEvaluator.Compiler">
      <HintPath>$(MSBuildThisFileDirectory)..\..\artifacts\compiler\FSharp.ExpressionEvaluator.Compiler.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The netstandard2.0 FSharp.Core, as a .NET Framework debuggee has it. -->
  <ItemGroup>
    <None Include="$(PkgFSharp_Core)\lib\netstandard2.0\FSharp.Core.dll" Link="netfx\FSharp.Core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" VersionOverride="10.1.402" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

</Project>
