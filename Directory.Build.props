<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <WarnOn>$(WarnOn);3390</WarnOn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- FSharp.Core is pinned explicitly per project (see docs/DESIGN.md §8). -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Set by hand. The third part is the git commit count (Directory.Build.targets). -->
    <VersionMajorMinor>0.1</VersionMajorMinor>
    <Version>$(VersionMajorMinor).0</Version>
    <Authors>Jakub Majocha</Authors>
  </PropertyGroup>
</Project>
